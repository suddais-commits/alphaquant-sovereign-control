# ============================================================================
# MASTER BOT CONFIGURATION (.env) - Updated for Playbook Alignment
# ============================================================================

# Binance API (for market data / signal generation)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Bybit DEMO Account API
BYBIT_API_KEY=YOUR_BYBIT_DEMO_KEY
BYBIT_API_SECRET=YOUR_BYBIT_DEMO_SECRET
BYBIT_CATEGORY=linear          # linear=USDT perpetual, spot=spot trading

# ============================================================================
# RISK MANAGEMENT - UPDATED
# ============================================================================
ACCOUNT_SIZE_USDT=5962         # Your actual demo balance (updated from 100)
RISK_PER_TRADE_PCT=1.0         # Risk 1-2% per trade. Increase only if you understand your stop size.
MAX_SL_PCT=3.0                 # Relaxed to allow more valid structure setups through
MAX_DAILY_LOSS_PCT=5.0         # If daily loss exceeds 5%, stop trading (soon: fully functional)
USE_ISOLATED_MARGIN=true       # Use isolated margin when available so one trade loss doesn't wipe whole cross-balance
MAX_LEVERAGE=12               # Cap per-trade leverage to limit tail risk and avoid 20x+ leverage defaults
MAX_MARGIN_UTILIZATION_PCT=40.0 # Target total margin usage for any single new position

# ============================================================================
# SIGNAL GENERATION - TUNABLE
# ============================================================================
SCORE_THRESHOLD=50
SCORE_FALLBACK_MARGIN=8
MIN_SL_DISTANCE_PCT=0.25       # Allow slightly tighter-but-still-valid stops; 0.6 was too strict for 1h data
MIN_RISK_REWARD_RATIO=1.5      # Accept 1.5:1 setups instead of only 2:1 trades
MANUAL_WATCHLIST_ENABLED=true             # Lowered from 70 for more signals. Options: 40-50... (balanced) | 65-70 (conservative)
TIMEFRAME=1h                   # Candle timeframe: 15m, 1h, 4h (recommended: 1h)
LOOP_INTERVAL_SECONDS=900      # Check signals every 15 min (900 sec)

# ============================================================================
# FEATURE FLAGS
# ============================================================================
EXCHANGE_EXECUTION_ENABLED=true
NEWS_FILTER_ENABLED=true       # Enable RSS-based news filter (crypto headlines)
TREND_FILTER_ENABLED=false     # EMA-based trend filter (currently disabled, can enable for testing)
MULTI_TIMEFRAME_CASCADE_ENABLED=true  # [NEW] Check Daily/4H/1H alignment before entry

# ============================================================================
# ON-CHAIN DATA (Layer 2)
# ============================================================================
ARKHAM_API_KEY=                # Arkham Intelligence API (currently unused - paid access)
DEFIFLAMA_FALLBACK=true        # Use DefiLlama if Arkham unavailable (always on)

# ============================================================================
# TELEGRAM NOTIFICATIONS (optional)
# ============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# If direct Telegram access is blocked by your network/firewall, configure a proxy.
# Example: PROXY_ENABLED=true, PROXY_HOST=p.webshare.io, PROXY_PORT=80,
# PROXY_USERNAME_PREFIX=<prefix>, PROXY_PASSWORD=<password>

# ============================================================================
# ADVANCED FEATURES [NEW]
# ============================================================================
STRUCTURE_BASED_TP_ENABLED=true        # Use swing highs/lows for TP levels instead of fixed %
INSTITUTIONAL_CANDLE_DETECTION=true    # Detect IFC (Institutional Funding) + Burst candles
ADVANCED_OB_DETECTION=true             # Detect Mitigation/Breaker/Refine/Rejection blocks
SCALE_OUT_AT_RR_ENABLED=true           # Automatic scale-out: 50% at 1:1 RR, SL→breakeven, 20% trailing
